# Kopiere diese Datei nach .env.local und trage den Key ein, den du vom
# House-Team bekommst. .env.local ist ignoriert und gehört nie ins Repo.
#
# Der Key ist im Browser mitlesbar - das ist so gewollt und kein Versehen.
# Er ist an Origins gebunden (localhost für die Entwicklung, die Screen-Domain
# für den Betrieb) und darf nur lesen. Siehe docs/api.md.
VITE_HOAI_API_KEY=hoai_hier_deinen_key
VITE_HOAI_API_BASE=https://membership.house-of-ai.org/api/public/v1
